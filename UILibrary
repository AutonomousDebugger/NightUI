-- ── Low-level helpers ─────────────────────────────────────────────────────────
local function N(cls, props)
    local o = Instance.new(cls)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then pcall(function() o[k] = v end) end
    end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function TW(o, t, p, s, d)
    TweenS:Create(o, TweenInfo.new(t, s or Enum.EasingStyle.Quad,
        d or Enum.EasingDirection.Out), p):Play()
end

local function Rnd(r, p)
    N("UICorner", { CornerRadius = UDim.new(0, r), Parent = p })
end

local function Pad(l, r, t, b, p)
    N("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0), PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
        Parent = p,
    })
end

local function Stroke(col, th, p)
    N("UIStroke", { Color = col, Thickness = th or 1, Parent = p })
end

-- ── Animated BG (orbs + faint scanlines) ─────────────────────────────────────
local function AnimBG(parent, zi)
    zi = zi or 1
    local bg = N("Frame", {
        Size = UDim2.new(1,0,1,0), BackgroundColor3 = C.BG,
        BorderSizePixel = 0, ZIndex = zi, ClipsDescendants = true, Parent = parent,
    })
    for i = 0, 22 do
        N("Frame", {
            Size = UDim2.new(1,0,0,1), Position = UDim2.new(0,0,0,i*17),
            BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.964,
            BorderSizePixel = 0, ZIndex = zi+1, Parent = bg,
        })
    end
    local orbs = {
        { Color3.fromRGB(68,22,195), 0.77 },
        { Color3.fromRGB(32,7,115),  0.81 },
        { Color3.fromRGB(88,14,168), 0.75 },
        { Color3.fromRGB(14,6,82),   0.83 },
    }
    for i, od in ipairs(orbs) do
        local orb = N("Frame", {
            Size = UDim2.new(0,170,0,170),
            Position = UDim2.new(math.random()*0.65, 0, math.random()*0.65, 0),
            BackgroundColor3 = od[1], BackgroundTransparency = od[2],
            BorderSizePixel = 0, ZIndex = zi+1, Parent = bg,
        })
        Rnd(999, orb)
        task.delay(i * 0.35, function()
            while orb and orb.Parent do
                TW(orb, math.random(4,9), {
                    Position = UDim2.new(math.random(0,65)/100, 0, math.random(0,65)/100, 0),
                    BackgroundTransparency = od[2] - 0.04 + math.random()*0.08,
                }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                task.wait(math.random(4,9))
            end
        end)
    end
    return bg
end

-- ── Drag (mouse + touch) ──────────────────────────────────────────────────────
local function Drag(handle, frame)
    local on, s0, p0 = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            on = true; s0 = i.Position; p0 = frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then on = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not on then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - s0
            frame.Position = UDim2.new(p0.X.Scale, p0.X.Offset+d.X, p0.Y.Scale, p0.Y.Offset+d.Y)
        end
    end)
end

-- ── Notification toasts ───────────────────────────────────────────────────────
local _notifRoot
local function Notif(opts)
    opts = opts or {}
    if not _notifRoot then return end
    local col = ({ info=C.Accent, success=C.OK, warn=C.WARN, error=C.ERR })[opts.Type or "info"] or C.Accent
    local card = N("Frame", {
        Size = UDim2.new(0,220,0,54), Position = UDim2.new(1,8,0,0),
        BackgroundColor3 = C.Card2, BorderSizePixel = 0, ZIndex = 60, Parent = _notifRoot,
    })
    Rnd(7, card); Stroke(col, 1, card)
    -- left colour bar
    local bar = N("Frame", {
        Size = UDim2.new(0,3,0,30), Position = UDim2.new(0,0,0.5,-15),
        BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 61, Parent = card,
    }); Rnd(2, bar)
    N("TextLabel", {
        Size = UDim2.new(1,-14,0,18), Position = UDim2.new(0,11,0,7),
        BackgroundTransparency = 1, Text = opts.Title or "", TextColor3 = C.Text,
        TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 62, Parent = card,
    })
    N("TextLabel", {
        Size = UDim2.new(1,-14,0,16), Position = UDim2.new(0,11,0,27),
        BackgroundTransparency = 1, Text = opts.Message or "", TextColor3 = C.TextS,
        TextSize = 10, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, ZIndex = 62, Parent = card,
    })
    TW(card, 0.25, { Position = UDim2.new(1,-228,0,0) }, Enum.EasingStyle.Back)
    task.delay(opts.Duration or 3, function()
        if not card.Parent then return end
        TW(card, 0.18, { Position = UDim2.new(1,8,0,0) })
        task.wait(0.2)
        if card.Parent then card:Destroy() end
    end)
end

