--[[
  NightUI v2.2
  github.com/AutonomousDebugger/NightUI

  LOAD:
    local UI = loadstring(game:HttpGet("RAW_URL"))()

  USAGE:
    local win = UI:Window({ Title="Hub", Key="abc123" })
    local tab = win:Tab("Main", "⚔️")
    tab:Button({ Name="Fly",    Callback=function() end })
    tab:Toggle({ Name="Noclip", Default=false, Callback=function(v) end })
    tab:Slider({ Name="Speed",  Min=0, Max=100, Default=16, Callback=function(v) end })
    tab:Dropdown({ Name="Mode", Items={"A","B"}, Callback=function(v) end })
    tab:TextBox({ Name="Name",  Placeholder="…", Callback=function(v) end })
    tab:Keybind({ Name="Key",   Callback=function(k) end })
    tab:Label("text") / tab:Separator("section")
    win:Notify({ Title="Hi", Message="ok!", Type="success" })
]]

local UIS    = game:GetService("UserInputService")
local TweenS = game:GetService("TweenService")
local CoreG  = game:GetService("CoreGui")

-- ── Theme ─────────────────────────────────────────────────────────────────────
local C = {
    BG       = Color3.fromRGB(7,   7,  11),
    Panel    = Color3.fromRGB(11,  10,  18),   -- sidebar bg  (slightly purple)
    Card     = Color3.fromRGB(19,  19,  28),   -- element cards
    Card2    = Color3.fromRGB(25,  25,  37),   -- input/track bg
    TabInact = Color3.fromRGB(20,  17,  36),   -- inactive tab button
    TabAct   = Color3.fromRGB(58,  45, 118),   -- active tab  (clear purple)
    TabHov   = Color3.fromRGB(36,  30,  62),   -- hover tab
    Accent   = Color3.fromRGB(108, 84, 255),
    AccentL  = Color3.fromRGB(148,120, 255),
    AccentD  = Color3.fromRGB(52,  40, 130),
    Text     = Color3.fromRGB(232,232, 244),
    TextDim  = Color3.fromRGB(140,140, 165),   -- inactive tab labels
    TextS    = Color3.fromRGB(110,110, 138),   -- subtitles, hints
    Border   = Color3.fromRGB(38,  35,  58),
    TOn      = Color3.fromRGB(108, 84, 255),
    TOff     = Color3.fromRGB(34,  34,  52),
    OK       = Color3.fromRGB(48, 208, 104),
    ERR      = Color3.fromRGB(215, 52,  62),
    WARN     = Color3.fromRGB(215,162,  32),
}

-- ── Helpers ───────────────────────────────────────────────────────────────────
local function N(cls, p)
    local o = Instance.new(cls)
    for k,v in pairs(p or {}) do
        if k~="Parent" then pcall(function() o[k]=v end) end
    end
    if p and p.Parent then o.Parent=p.Parent end
    return o
end
local function TW(o,t,p,s,d)
    TweenS:Create(o,TweenInfo.new(t,s or Enum.EasingStyle.Quad,
        d or Enum.EasingDirection.Out),p):Play()
end
local function Rnd(r,p)   N("UICorner",{CornerRadius=UDim.new(0,r),Parent=p}) end
local function Pad(l,r,t,b,p)
    N("UIPadding",{PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0),
                   PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0),Parent=p})
end
local function Stroke(col,th,p) N("UIStroke",{Color=col,Thickness=th or 1,Parent=p}) end

-- ── Animated background ───────────────────────────────────────────────────────
local function AnimBG(parent, zi)
    zi = zi or 1
    local bg = N("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=C.BG,
                           BorderSizePixel=0,ZIndex=zi,ClipsDescendants=true,Parent=parent})
    for i=0,20 do
        N("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0,i*18),
                   BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.966,
                   BorderSizePixel=0,ZIndex=zi+1,Parent=bg})
    end
    local orbs={
        {Color3.fromRGB(65,20,190),0.77},{Color3.fromRGB(30,6,112),0.81},
        {Color3.fromRGB(85,12,165),0.75},{Color3.fromRGB(12,5,80),0.83},
    }
    for i,od in ipairs(orbs) do
        local orb=N("Frame",{Size=UDim2.new(0,165,0,165),
            Position=UDim2.new(math.random()*0.65,0,math.random()*0.65,0),
            BackgroundColor3=od[1],BackgroundTransparency=od[2],
            BorderSizePixel=0,ZIndex=zi+1,Parent=bg})
        Rnd(999,orb)
        task.delay(i*0.4,function()
            while orb and orb.Parent do
                TW(orb,math.random(4,9),{
                    Position=UDim2.new(math.random(0,65)/100,0,math.random(0,65)/100,0),
                    BackgroundTransparency=od[2]-0.03+math.random()*0.07,
                },Enum.EasingStyle.Sine,Enum.EasingDirection.InOut)
                task.wait(math.random(4,9))
            end
        end)
    end
    return bg
end

-- ── Drag ──────────────────────────────────────────────────────────────────────
local function Drag(handle, frame)
    local on,s0,p0=false,nil,nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or
           i.UserInputType==Enum.UserInputType.Touch then
            on=true; s0=i.Position; p0=frame.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then on=false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not on then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or
           i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-s0
            frame.Position=UDim2.new(p0.X.Scale,p0.X.Offset+d.X,p0.Y.Scale,p0.Y.Offset+d.Y)
        end
    end)
end

-- ── Notifications ─────────────────────────────────────────────────────────────
local _notifRoot
local function Notif(opts)
    opts=opts or {}
    if not _notifRoot then return end
    local col=({info=C.Accent,success=C.OK,warn=C.WARN,error=C.ERR})[opts.Type or"info"] or C.Accent
    local card=N("Frame",{Size=UDim2.new(0,220,0,52),Position=UDim2.new(1,8,0,0),
        BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=60,Parent=_notifRoot})
    Rnd(7,card); Stroke(col,1,card)
    N("Frame",{Size=UDim2.new(0,3,0,28),Position=UDim2.new(0,0,0.5,-14),
               BackgroundColor3=col,BorderSizePixel=0,ZIndex=61,Parent=card})
    N("TextLabel",{Size=UDim2.new(1,-14,0,17),Position=UDim2.new(0,11,0,6),
        BackgroundTransparency=1,Text=opts.Title or"",TextColor3=C.Text,
        TextSize=11,Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=62,Parent=card})
    N("TextLabel",{Size=UDim2.new(1,-14,0,16),Position=UDim2.new(0,11,0,25),
        BackgroundTransparency=1,Text=opts.Message or"",TextColor3=C.TextS,
        TextSize=10,Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,ZIndex=62,Parent=card})
    TW(card,0.24,{Position=UDim2.new(1,-228,0,0)},Enum.EasingStyle.Back)
    task.delay(opts.Duration or 3,function()
        if not card.Parent then return end
        TW(card,0.18,{Position=UDim2.new(1,8,0,0)})
        task.wait(0.2); if card.Parent then card:Destroy() end
    end)
end

-- ══════════════════════════════════════════════════════════════════════════════
local NightUI={}; NightUI.__index=NightUI

function NightUI:Window(opts)
    opts=opts or {}
    local TITLE=opts.Title    or "NightUI"
    local SUB  =opts.SubTitle or ""
    local KEY  =opts.Key
    local W,H  =opts.Width or 300, opts.Height or 360
    local TBH  =34   -- title bar height
    local SW   =70   -- sidebar width

    local win  ={}
    local tabs ={}

    -- ── ScreenGui ─────────────────────────────────────────────────────────────
    local sg=N("ScreenGui",{Name="NightUI_"..TITLE,ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=100,Parent=CoreG})

    _notifRoot=N("Frame",{Size=UDim2.new(0,240,1,0),Position=UDim2.new(1,-248,0,8),
        BackgroundTransparency=1,ZIndex=59,Parent=sg})
    N("UIListLayout",{Padding=UDim.new(0,4),FillDirection=Enum.FillDirection.Vertical,
        VerticalAlignment=Enum.VerticalAlignment.Top,Parent=_notifRoot})

    -- ── Window frame ──────────────────────────────────────────────────────────
    local frame=N("Frame",{Size=UDim2.new(0,W,0,H),Position=UDim2.new(0.5,-W/2,0.5,-H/2),
        BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,Parent=sg})
    AnimBG(frame,1)
    -- border (drawn last so it's on top of everything)
    local bord=N("Frame",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        BorderSizePixel=0,ZIndex=20,Parent=frame})
    Rnd(10,bord); Stroke(C.Border,1,bord)

    -- ── Title bar ─────────────────────────────────────────────────────────────
    local tb=N("Frame",{Size=UDim2.new(1,0,0,TBH),BackgroundColor3=C.Panel,
        BackgroundTransparency=0,BorderSizePixel=0,ZIndex=10,Parent=frame})
    N("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),
        BackgroundColor3=C.Accent,BackgroundTransparency=0.5,BorderSizePixel=0,ZIndex=11,Parent=tb})
    local dot=N("Frame",{Size=UDim2.new(0,6,0,6),Position=UDim2.new(0,12,0.5,-3),
        BackgroundColor3=C.Accent,BorderSizePixel=0,ZIndex=11,Parent=tb})
    Rnd(999,dot)
    task.spawn(function()
        while dot and dot.Parent do
            TW(dot,0.9,{BackgroundColor3=C.AccentL},Enum.EasingStyle.Sine)
            task.wait(0.9)
            TW(dot,0.9,{BackgroundColor3=C.Accent},Enum.EasingStyle.Sine)
            task.wait(0.9)
        end
    end)
    N("TextLabel",{Size=UDim2.new(1,-82,1,0),Position=UDim2.new(0,23,0,0),
        BackgroundTransparency=1,
        Text=TITLE..(SUB~=""and("  ·  "..SUB)or""),
        TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=tb})

    -- Close / Min buttons
    local function CtrlBtn(xOff,bg)
        local b=N("TextButton",{Size=UDim2.new(0,18,0,18),Position=UDim2.new(1,xOff,0.5,-9),
            BackgroundColor3=bg,BorderSizePixel=0,Text="",ZIndex=12,Parent=tb})
        Rnd(4,b); return b
    end
    local closeBtn=CtrlBtn(-22,C.ERR)
    local minBtn  =CtrlBtn(-44,C.WARN)
    for _,rot in ipairs({45,-45}) do
        local l=N("Frame",{Size=UDim2.new(0,8,0,1.5),AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0.5,0),Rotation=rot,
            BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=13,Parent=closeBtn})
        Rnd(1,l)
    end
    N("Frame",{Size=UDim2.new(0,8,0,1.5),AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0),BackgroundColor3=Color3.new(1,1,1),
        BorderSizePixel=0,ZIndex=13,Parent=minBtn})

    Drag(tb,frame)
    local minimised=false
    closeBtn.MouseButton1Click:Connect(function()
        TW(frame,0.14,{Size=UDim2.new(0,W,0,0),Position=UDim2.new(0.5,-W/2,0.5,0)})
        task.wait(0.15); sg:Destroy()
    end)
    minBtn.MouseButton1Click:Connect(function()
        minimised=not minimised
        TW(frame,0.16,{Size=UDim2.new(0,W,0,minimised and TBH or H)},Enum.EasingStyle.Quad)
    end)
    closeBtn.MouseEnter:Connect(function() TW(closeBtn,0.08,{BackgroundColor3=Color3.fromRGB(255,72,82)}) end)
    closeBtn.MouseLeave:Connect(function() TW(closeBtn,0.08,{BackgroundColor3=C.ERR}) end)
    minBtn.MouseEnter:Connect(function()   TW(minBtn,0.08,{BackgroundColor3=Color3.fromRGB(255,195,50)}) end)
    minBtn.MouseLeave:Connect(function()   TW(minBtn,0.08,{BackgroundColor3=C.WARN}) end)

    -- ── SIDEBAR ───────────────────────────────────────────────────────────────
    -- Solid panel so tab buttons have a distinct background to contrast against
    local sidebar=N("Frame",{
        Size    =UDim2.new(0,SW,1,-TBH),
        Position=UDim2.new(0,0,0,TBH),
        BackgroundColor3   =C.Panel,
        BackgroundTransparency=0,        -- fully opaque — must be solid
        BorderSizePixel=0,
        ZIndex=8,
        Parent=frame,
    })
    -- right divider line in accent colour
    N("Frame",{Size=UDim2.new(0,1,1,0),Position=UDim2.new(1,-1,0,0),
        BackgroundColor3=C.Accent,BackgroundTransparency=0.7,
        BorderSizePixel=0,ZIndex=9,Parent=sidebar})

    local sbList=N("UIListLayout",{Padding=UDim.new(0,3),
        FillDirection=Enum.FillDirection.Vertical,
        HorizontalAlignment=Enum.HorizontalAlignment.Center,
        Parent=sidebar})
    Pad(5,5,6,6,sidebar)

    -- ── CONTENT ───────────────────────────────────────────────────────────────
    local content=N("Frame",{
        Size    =UDim2.new(1,-SW,1,-TBH),
        Position=UDim2.new(0,SW,0,TBH),
        BackgroundTransparency=1,BorderSizePixel=0,ZIndex=7,Parent=frame,
    })

    -- entrance animation
    local bp=frame.Position
    frame.Position=UDim2.new(bp.X.Scale,bp.X.Offset,bp.Y.Scale+0.05,bp.Y.Offset)
    TW(frame,0.3,{Position=bp},Enum.EasingStyle.Back)

    -- ════════════════════════════════════════════════════════════════════════
    --  :Tab(name, icon)
    -- ════════════════════════════════════════════════════════════════════════
    function win:Tab(name, icon)
        local tabObj={}
        icon=icon or ""

        -- ── Sidebar tab button ────────────────────────────────────────────────
        -- Uses a CLEARLY VISIBLE background so it looks like a real button
        local btn=N("TextButton",{
            Size            =UDim2.new(1,0,0,50),
            BackgroundColor3=C.TabInact,   -- visible dark-purple bg
            BackgroundTransparency=0,       -- fully opaque — always visible
            BorderSizePixel =0,
            Text            ="",
            AutoButtonColor =false,
            ZIndex          =9,
            Parent          =sidebar,
        })
        Rnd(6,btn)
        -- subtle border so each button is clearly bounded
        local btnStroke=Stroke(C.Border,1,btn)

        -- left accent bar (hidden when inactive, shown when active)
        local bar=N("Frame",{
            Size            =UDim2.new(0,3,0,24),
            AnchorPoint     =Vector2.new(0,0.5),
            Position        =UDim2.new(0,0,0.5,0),
            BackgroundColor3=C.Accent,
            BackgroundTransparency=1,       -- hidden until active
            BorderSizePixel =0,
            ZIndex          =10,
            Parent          =btn,
        }); Rnd(2,bar)

        -- icon (top centre of button)
        local icoLbl
        if icon~="" then
            icoLbl=N("TextLabel",{
                Size            =UDim2.new(1,0,0,22),
                Position        =UDim2.new(0,0,0,4),
                BackgroundTransparency=1,
                Text            =icon,
                TextColor3      =C.TextDim,   -- dim when inactive
                TextSize        =15,
                Font            =Enum.Font.GothamBold,
                ZIndex          =10,
                Parent          =btn,
            })
        end

        -- name label (below icon, or centred if no icon)
        local nameLbl=N("TextLabel",{
            Size            =UDim2.new(1,-4,0,13),
            Position        =UDim2.new(0,2,0,icon~=""and 27 or 18),
            BackgroundTransparency=1,
            Text            =name,
            TextColor3      =C.TextDim,   -- dim when inactive
            TextSize        =9,
            Font            =Enum.Font.GothamMedium,
            TextWrapped     =true,
            ZIndex          =10,
            Parent          =btn,
        })

        -- ── Scroll frame for tab content ──────────────────────────────────────
        local scroll=N("ScrollingFrame",{
            Size             =UDim2.new(1,0,1,0),
            BackgroundTransparency=1,BorderSizePixel=0,
            ScrollBarThickness=2,ScrollBarImageColor3=C.AccentD,
            CanvasSize       =UDim2.new(0,0,0,0),
            AutomaticCanvasSize=Enum.AutomaticSize.Y,
            Visible          =false,
            ZIndex           =8,
            Parent           =content,
        })
        N("UIListLayout",{Padding=UDim.new(0,5),FillDirection=Enum.FillDirection.Vertical,
            SortOrder=Enum.SortOrder.LayoutOrder,Parent=scroll})
        Pad(7,7,7,7,scroll)

        -- ── Activate / deactivate ─────────────────────────────────────────────
        local function activate()
            -- deactivate all tabs
            for _,t in ipairs(tabs) do
                t._s.Visible=false
                TW(t._btn,0.14,{BackgroundColor3=C.TabInact,BackgroundTransparency=0})
                TW(t._bar,0.14,{BackgroundTransparency=1})
                if t._ico  then TW(t._ico, 0.14,{TextColor3=C.TextDim}) end
                if t._name then TW(t._name,0.14,{TextColor3=C.TextDim}) end
                if t._stroke then TW(t._stroke,0.14,{Color=C.Border}) end
            end
            -- activate this tab
            scroll.Visible=true
            TW(btn,   0.14,{BackgroundColor3=C.TabAct,BackgroundTransparency=0})
            TW(bar,   0.14,{BackgroundTransparency=0})
            if icoLbl  then TW(icoLbl, 0.14,{TextColor3=C.AccentL}) end
            TW(nameLbl,0.14,{TextColor3=C.Text})
            if btnStroke then TW(btnStroke,0.14,{Color=C.AccentD}) end
        end

        btn.MouseButton1Click:Connect(activate)
        btn.MouseEnter:Connect(function()
            -- only change if not active
            if scroll.Visible then return end
            TW(btn,0.1,{BackgroundColor3=C.TabHov})
        end)
        btn.MouseLeave:Connect(function()
            if scroll.Visible then return end
            TW(btn,0.1,{BackgroundColor3=C.TabInact})
        end)

        tabObj._btn   =btn
        tabObj._s     =scroll
        tabObj._bar   =bar
        tabObj._ico   =icoLbl
        tabObj._name  =nameLbl
        tabObj._stroke=btnStroke
        table.insert(tabs,tabObj)
        if #tabs==1 then activate() end

        -- ── Card helper ───────────────────────────────────────────────────────
        local function Card(h)
            local c=N("Frame",{Size=UDim2.new(1,0,0,h),BackgroundColor3=C.Card,
                BorderSizePixel=0,ZIndex=9,Parent=scroll})
            Rnd(6,c); return c
        end

        -- ── Button ────────────────────────────────────────────────────────────
        function tabObj:Button(o)
            o=o or {}
            local c=Card(32)
            N("TextLabel",{Size=UDim2.new(1,-26,1,0),Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1,Text=o.Name or"Button",
                TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamMedium,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=c})
            N("TextLabel",{Size=UDim2.new(0,14,1,0),Position=UDim2.new(1,-16,0,0),
                BackgroundTransparency=1,Text="›",TextColor3=C.AccentL,
                TextSize=14,Font=Enum.Font.GothamBold,ZIndex=10,Parent=c})
            local hit=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                Text="",ZIndex=11,Parent=c})
            hit.MouseButton1Click:Connect(function()
                TW(c,0.07,{BackgroundColor3=C.AccentD})
                task.wait(0.07); TW(c,0.13,{BackgroundColor3=C.Card})
                if o.Callback then o.Callback() end
            end)
            hit.MouseEnter:Connect(function() TW(c,0.1,{BackgroundColor3=C.Card2}) end)
            hit.MouseLeave:Connect(function() TW(c,0.1,{BackgroundColor3=C.Card}) end)
            return tabObj
        end

        -- ── Toggle ────────────────────────────────────────────────────────────
        function tabObj:Toggle(o)
            o=o or {}
            local state=o.Default or false
            local c=Card(32)
            N("TextLabel",{Size=UDim2.new(1,-52,1,0),Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1,Text=o.Name or"Toggle",
                TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamMedium,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=c})
            local track=N("Frame",{Size=UDim2.new(0,34,0,18),Position=UDim2.new(1,-42,0.5,-9),
                BackgroundColor3=C.TOff,BorderSizePixel=0,ZIndex=10,Parent=c})
            Rnd(999,track)
            local knob=N("Frame",{Size=UDim2.new(0,12,0,12),Position=UDim2.new(0,3,0.5,-6),
                BackgroundColor3=Color3.fromRGB(185,185,210),BorderSizePixel=0,ZIndex=11,Parent=track})
            Rnd(999,knob)
            local function refresh(a)
                local fn=a and TW or function(ob,_,pr) for k,v in pairs(pr) do pcall(function() ob[k]=v end) end end
                fn(track,0.15,{BackgroundColor3=state and C.TOn or C.TOff})
                fn(knob, 0.15,{Position=state and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6)})
            end
            refresh(false)
            N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=12,Parent=c})
                .MouseButton1Click:Connect(function()
                    state=not state; refresh(true)
                    if o.Callback then o.Callback(state) end
                end)
            local api={}
            function api:Set(v) state=v; refresh(true); if o.Callback then o.Callback(state) end end
            function api:Get()    return state end
            function api:Toggle() state=not state; refresh(true); if o.Callback then o.Callback(state) end end
            return api
        end

        -- ── Slider ────────────────────────────────────────────────────────────
        function tabObj:Slider(o)
            o=o or {}
            local mn,mx=o.Min or 0,o.Max or 100
            local step=o.Step or 1
            local val=math.clamp(o.Default or mn,mn,mx)
            local c=Card(46)
            local row=N("Frame",{Size=UDim2.new(1,-20,0,18),Position=UDim2.new(0,10,0,5),
                BackgroundTransparency=1,ZIndex=10,Parent=c})
            N("TextLabel",{Size=UDim2.new(1,-34,1,0),BackgroundTransparency=1,
                Text=o.Name or"Slider",TextColor3=C.Text,TextSize=11,
                Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=row})
            local vLbl=N("TextLabel",{Size=UDim2.new(0,32,1,0),Position=UDim2.new(1,-32,0,0),
                BackgroundTransparency=1,Text=tostring(val),TextColor3=C.AccentL,
                TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=10,Parent=row})
            local trk=N("Frame",{Size=UDim2.new(1,-20,0,5),Position=UDim2.new(0,10,1,-10),
                BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=10,Parent=c})
            Rnd(999,trk)
            local fill=N("Frame",{Size=UDim2.new((val-mn)/(mx-mn),0,1,0),
                BackgroundColor3=C.Accent,BorderSizePixel=0,ZIndex=11,Parent=trk})
            Rnd(999,fill)
            local thumb=N("Frame",{Size=UDim2.new(0,11,0,11),AnchorPoint=Vector2.new(0.5,0.5),
                Position=UDim2.new((val-mn)/(mx-mn),0,0.5,0),
                BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=12,Parent=trk})
            Rnd(999,thumb)
            local function setV(x)
                local rel=math.clamp((x-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)
                val=math.clamp(math.round((mn+(mx-mn)*rel)/step)*step,mn,mx)
                local pct=(val-mn)/(mx-mn)
                fill.Size=UDim2.new(pct,0,1,0); thumb.Position=UDim2.new(pct,0,0.5,0)
                vLbl.Text=tostring(val)
                if o.Callback then o.Callback(val) end
            end
            local sliding=false
            trk.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or
                   i.UserInputType==Enum.UserInputType.Touch then
                    sliding=true; setV(i.Position.X) end end)
            UIS.InputChanged:Connect(function(i)
                if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement or
                   i.UserInputType==Enum.UserInputType.Touch) then setV(i.Position.X) end end)
            UIS.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or
                   i.UserInputType==Enum.UserInputType.Touch then sliding=false end end)
            local api={}
            function api:Set(v)
                val=math.clamp(v,mn,mx); local pct=(val-mn)/(mx-mn)
                fill.Size=UDim2.new(pct,0,1,0); thumb.Position=UDim2.new(pct,0,0.5,0); vLbl.Text=tostring(val)
            end
            function api:Get() return val end
            return api
        end

        -- ── Dropdown ──────────────────────────────────────────────────────────
        function tabObj:Dropdown(o)
            o=o or {}
            local items=o.Items or {}
            local sel=o.Default or items[1] or "Select"
            local open=false
            local c=Card(32)
            N("TextLabel",{Size=UDim2.new(0.5,0,1,0),Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1,Text=o.Name or"Dropdown",TextColor3=C.Text,
                TextSize=11,Font=Enum.Font.GothamMedium,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=c})
            local box=N("Frame",{Size=UDim2.new(0,96,0,22),Position=UDim2.new(1,-104,0.5,-11),
                BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=10,Parent=c})
            Rnd(5,box)
            local sLbl=N("TextLabel",{Size=UDim2.new(1,-18,1,0),Position=UDim2.new(0,7,0,0),
                BackgroundTransparency=1,Text=sel,TextColor3=C.Text,TextSize=10,
                Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=box})
            local arr=N("TextLabel",{Size=UDim2.new(0,14,1,0),Position=UDim2.new(1,-15,0,0),
                BackgroundTransparency=1,Text="▾",TextColor3=C.TextS,TextSize=10,ZIndex=11,Parent=box})
            local list=N("Frame",{Size=UDim2.new(0,96,0,0),Position=UDim2.new(1,-104,1,3),
                BackgroundColor3=C.Card2,BorderSizePixel=0,ClipsDescendants=true,
                Visible=false,ZIndex=22,Parent=c})
            Rnd(5,list); Stroke(C.Border,1,list)
            N("UIListLayout",{Padding=UDim.new(0,1),Parent=list}); Pad(3,3,3,3,list)
            for _,item in ipairs(items) do
                local ib=N("TextButton",{Size=UDim2.new(1,0,0,22),BackgroundColor3=C.Card,
                    BackgroundTransparency=0.4,BorderSizePixel=0,Text=item,TextColor3=C.TextS,
                    TextSize=10,Font=Enum.Font.Gotham,ZIndex=23,Parent=list})
                Rnd(3,ib)
                ib.MouseButton1Click:Connect(function()
                    sel=item; sLbl.Text=item; open=false
                    TW(list,0.12,{Size=UDim2.new(0,96,0,0)}); TW(arr,0.12,{Rotation=0})
                    task.wait(0.13); list.Visible=false
                    if o.Callback then o.Callback(sel) end
                end)
                ib.MouseEnter:Connect(function() TW(ib,0.07,{TextColor3=C.Text}) end)
                ib.MouseLeave:Connect(function() TW(ib,0.07,{TextColor3=C.TextS}) end)
            end
            local hit=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                Text="",ZIndex=11,Parent=c})
            hit.MouseButton1Click:Connect(function()
                open=not open; list.Visible=true
                TW(list,0.15,{Size=UDim2.new(0,96,0,open and(#items*23+6)or 0)})
                TW(arr,0.15,{Rotation=open and 180 or 0})
                if not open then task.wait(0.16); list.Visible=false end
            end)
            local api={}
            function api:Set(v) sel=v; sLbl.Text=v end
            function api:Get()  return sel end
            return api
        end

        -- ── TextBox ───────────────────────────────────────────────────────────
        function tabObj:TextBox(o)
            o=o or {}
            local c=Card(44)
            N("TextLabel",{Size=UDim2.new(1,-20,0,16),Position=UDim2.new(0,10,0,4),
                BackgroundTransparency=1,Text=o.Name or"Input",TextColor3=C.TextS,
                TextSize=9,Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=c})
            local box=N("TextBox",{Size=UDim2.new(1,-20,0,19),Position=UDim2.new(0,10,1,-23),
                BackgroundColor3=C.Card2,BorderSizePixel=0,Text=o.Default or"",
                PlaceholderText=o.Placeholder or"Type…",TextColor3=C.Text,
                PlaceholderColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                ClearTextOnFocus=false,ZIndex=10,Parent=c})
            Rnd(4,box); Pad(7,0,0,0,box)
            box.Focused:Connect(function()   Stroke(C.Accent,1,box) end)
            box.FocusLost:Connect(function(enter)
                for _,s in ipairs(box:GetChildren()) do
                    if s:IsA("UIStroke") then s:Destroy() end end
                if enter and o.Callback then o.Callback(box.Text) end
            end)
            local api={}
            function api:Get() return box.Text end
            function api:Set(v) box.Text=v end
            return api
        end

        -- ── Label ─────────────────────────────────────────────────────────────
        function tabObj:Label(text)
            local l=N("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,
                Text=text or"",TextColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=scroll})
            Pad(4,0,0,0,l)
            local api={}
            function api:Set(t) l.Text=t end
            function api:Get()  return l.Text end
            return api
        end

        -- ── Separator ─────────────────────────────────────────────────────────
        function tabObj:Separator(lbl)
            local g=N("Frame",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1,
                ZIndex=9,Parent=scroll})
            N("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0.5,0),
                BackgroundColor3=C.Border,BorderSizePixel=0,ZIndex=9,Parent=g})
            if lbl and lbl~="" then
                local lf=N("Frame",{Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,
                    AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,0),
                    BackgroundColor3=C.BG,BorderSizePixel=0,ZIndex=10,Parent=g})
                Pad(5,5,0,0,lf)
                N("TextLabel",{Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,
                    BackgroundTransparency=1,Text=lbl,TextColor3=C.TextS,
                    TextSize=9,Font=Enum.Font.GothamMedium,ZIndex=10,Parent=lf})
            end
        end

        -- ── Keybind ───────────────────────────────────────────────────────────
        function tabObj:Keybind(o)
            o=o or {}
            local bound,waiting=o.Default,false
            local c=Card(32)
            N("TextLabel",{Size=UDim2.new(0.55,0,1,0),Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1,Text=o.Name or"Keybind",TextColor3=C.Text,
                TextSize=11,Font=Enum.Font.GothamMedium,
                TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=c})
            local kf=N("Frame",{Size=UDim2.new(0,60,0,20),Position=UDim2.new(1,-68,0.5,-10),
                BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=10,Parent=c})
            Rnd(4,kf)
            local kl=N("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                Text=bound and tostring(bound):gsub("Enum.KeyCode.","") or"None",
                TextColor3=C.AccentL,TextSize=9,Font=Enum.Font.GothamBold,ZIndex=11,Parent=kf})
            local hit=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                Text="",ZIndex=12,Parent=c})
            hit.MouseButton1Click:Connect(function()
                waiting=true; kl.Text="…"; TW(kf,0.1,{BackgroundColor3=C.AccentD})
            end)
            UIS.InputBegan:Connect(function(i)
                if not waiting then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    waiting=false; bound=i.KeyCode
                    kl.Text=tostring(i.KeyCode):gsub("Enum.KeyCode.","")
                    TW(kf,0.1,{BackgroundColor3=C.Card2})
                    if o.Callback then o.Callback(bound) end
                end
            end)
            local api={}
            function api:Get() return bound end
            function api:Set(kc) bound=kc; kl.Text=tostring(kc):gsub("Enum.KeyCode.","") end
            return api
        end

        return tabObj
    end  -- :Tab()

    function win:Notify(o) Notif(o) end
    function win:Destroy() sg:Destroy() end

    -- ════════════════════════════════════════════════════════════════════════
    --  KEY GATE  (overlay — window already built so :Tab() always works)
    -- ════════════════════════════════════════════════════════════════════════
    if KEY then
        local keys=type(KEY)=="table" and KEY or {KEY}

        local overlay=N("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),
            BackgroundTransparency=0.35,ZIndex=90,Parent=sg})

        local kcard=N("Frame",{Size=UDim2.new(0,252,0,162),
            Position=UDim2.new(0.5,-126,0.5,-81),
            BackgroundColor3=C.Panel,BorderSizePixel=0,ZIndex=95,Parent=sg})
        Rnd(10,kcard); Stroke(C.Accent,1,kcard)
        N("Frame",{Size=UDim2.new(1,0,0,3),BackgroundColor3=C.Accent,
            BorderSizePixel=0,ZIndex=96,Parent=kcard})

        N("TextLabel",{Size=UDim2.new(1,0,0,32),Position=UDim2.new(0,0,0,8),
            BackgroundTransparency=1,Text="🔑  Key Required",
            TextColor3=C.Text,TextSize=13,Font=Enum.Font.GothamBold,ZIndex=96,Parent=kcard})
        N("TextLabel",{Size=UDim2.new(1,-24,0,14),Position=UDim2.new(0,12,0,38),
            BackgroundTransparency=1,Text="Enter your access key below",
            TextColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
            TextXAlignment=Enum.TextXAlignment.Left,ZIndex=96,Parent=kcard})

        local kinput=N("TextBox",{Size=UDim2.new(1,-24,0,30),Position=UDim2.new(0,12,0,58),
            BackgroundColor3=C.Card2,BorderSizePixel=0,Text="",
            PlaceholderText="paste key here…",TextColor3=C.Text,PlaceholderColor3=C.TextS,
            TextSize=11,Font=Enum.Font.GothamMedium,ClearTextOnFocus=false,ZIndex=97,Parent=kcard})
        Rnd(6,kinput); Pad(10,0,0,0,kinput); Stroke(C.Border,1,kinput)

        local ubtn=N("TextButton",{Size=UDim2.new(1,-24,0,28),Position=UDim2.new(0,12,0,96),
            BackgroundColor3=C.Accent,BorderSizePixel=0,Text="Unlock",
            TextColor3=Color3.new(1,1,1),TextSize=11,Font=Enum.Font.GothamBold,
            ZIndex=97,Parent=kcard})
        Rnd(6,ubtn)

        local eLbl=N("TextLabel",{Size=UDim2.new(1,-24,0,13),Position=UDim2.new(0,12,0,130),
            BackgroundTransparency=1,Text="",TextColor3=C.ERR,TextSize=9,Font=Enum.Font.Gotham,
            TextXAlignment=Enum.TextXAlignment.Left,ZIndex=96,Parent=kcard})

        kcard.Position=UDim2.new(0.5,-126,0.54,-81); kcard.BackgroundTransparency=1
        TW(kcard,0.26,{Position=UDim2.new(0.5,-126,0.5,-81),BackgroundTransparency=0},Enum.EasingStyle.Back)

        local function shake()
            for _,dx in ipairs({-6,6,-4,4,-2,2,0}) do
                TW(kcard,0.04,{Position=UDim2.new(0.5,-126+dx,0.5,-81)}); task.wait(0.04)
            end
        end

        local function check()
            local v=kinput.Text:gsub("%s","")
            for _,k in ipairs(keys) do
                if v==k then
                    TW(ubtn,0.15,{BackgroundColor3=C.OK}); task.wait(0.3)
                    TW(overlay,0.2,{BackgroundTransparency=1})
                    TW(kcard,  0.2,{BackgroundTransparency=1})
                    task.wait(0.22)
                    overlay:Destroy(); kcard:Destroy()
                    -- force first tab visible after gate clears
                    if tabs[1] then
                        tabs[1]._s.Visible=true
                        TW(tabs[1]._btn,0.14,{BackgroundColor3=C.TabAct,BackgroundTransparency=0})
                        TW(tabs[1]._bar,0.14,{BackgroundTransparency=0})
                        if tabs[1]._ico  then TW(tabs[1]._ico, 0.14,{TextColor3=C.AccentL}) end
                        if tabs[1]._name then TW(tabs[1]._name,0.14,{TextColor3=C.Text}) end
                    end
                    return
                end
            end
            eLbl.Text="✕  Wrong key"
            TW(ubtn,0.07,{BackgroundColor3=C.ERR}); task.wait(0.08)
            TW(ubtn,0.13,{BackgroundColor3=C.Accent})
            shake()
            task.delay(2.5,function() if eLbl and eLbl.Parent then eLbl.Text="" end end)
        end

        ubtn.MouseButton1Click:Connect(check)
        kinput.FocusLost:Connect(function(enter) if enter then check() end end)
        ubtn.MouseEnter:Connect(function() TW(ubtn,0.08,{BackgroundColor3=C.AccentL}) end)
        ubtn.MouseLeave:Connect(function() TW(ubtn,0.08,{BackgroundColor3=C.Accent}) end)
    end

    return win
end

