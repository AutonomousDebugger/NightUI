--// Helpers
local function create(className, props, children)
	local obj = Instance.new(className)

	for prop, value in pairs(props or {}) do
		obj[prop] = value
	end

	for _, child in ipairs(children or {}) do
		child.Parent = obj
	end

	return obj
end

local function corner(radius)
	return create("UICorner", {
		CornerRadius = UDim.new(0, radius or 8)
	})
end

local function stroke(color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Color3.fromRGB(45, 45, 55),
		Thickness = thickness or 1,
		Transparency = transparency or 0
	})
end

local function padding(px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px)
	})
end

local function trimText(text)
	return tostring(text):gsub("^%s+", ""):gsub("%s+$", "")
end

local function makeDraggable(frame, dragHandle)
	local dragging = false
	local dragStart = nil
	local startPos = nil

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			local delta = input.Position - dragStart

			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function checkKey(inputKey, keyList)
	inputKey = trimText(inputKey)

	for _, validKey in ipairs(keyList or {}) do
		validKey = trimText(validKey)

		if inputKey == validKey then
			return true
		end
	end

	return false
end

local function createAnimatedBackground(parent)
	local background = create("Frame", {
		Name = "KeyAnimatedBackground",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(2, 2, 5),
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = parent
	})

	local bgGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(13, 13, 20)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
		}),
		Rotation = 0,
		Parent = background
	})

	task.spawn(function()
		while background.Parent do
			local tween = TweenService:Create(
				bgGradient,
				TweenInfo.new(5, Enum.EasingStyle.Linear),
				{
					Rotation = bgGradient.Rotation + 180
				}
			)

			tween:Play()
			tween.Completed:Wait()
		end
	end)

	for i = 1, 24 do
		local dot = create("Frame", {
			Name = "DepthDot",
			Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5)),
			Position = UDim2.fromScale(math.random(), math.random()),
			BackgroundColor3 = Color3.fromRGB(35, 35, 50),
			BackgroundTransparency = math.random(35, 75) / 100,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = background
		}, {
			corner(99)
		})

		task.spawn(function()
			while dot.Parent do
				local tween = TweenService:Create(
					dot,
					TweenInfo.new(math.random(4, 9), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{
						Position = UDim2.fromScale(math.random(), math.random())
					}
				)

				tween:Play()
				tween.Completed:Wait()
			end
		end)
	end

	return background
end

