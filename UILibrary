			BackgroundColor3 = Color3.fromRGB(30, 30, 45),
			Text = "Unlock",
			TextColor3 = Color3.fromRGB(240, 240, 250),
			TextSize = 13,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			ZIndex = 51,
			Parent = keyFrame
		}, {
			corner(7)
		})

		local unlocked = false

		local function unlock()
			if unlocked then
				return
			end

			local typedKey = trimText(keyBox.Text)

			if checkKey(typedKey, keys) then
				unlocked = true

				status.TextColor3 = Color3.fromRGB(100, 255, 150)
				status.Text = "Correct key."

				task.delay(0.15, function()
					if keyFrame and keyFrame.Parent then
						keyFrame.Visible = false
						keyFrame:Destroy()
					end

					if keyBackground and keyBackground.Parent then
						keyBackground.Visible = false
						keyBackground:Destroy()
					end

					main.Visible = true
					openButton.Visible = false
				end)
			else
				status.TextColor3 = Color3.fromRGB(255, 100, 100)
				status.Text = "Invalid key."
			end
		end

		submit.MouseButton1Click:Connect(unlock)

		keyBox.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				unlock()
			end
		end)
	else
		main.Visible = true
		openButton.Visible = false
	end

	return window
end

