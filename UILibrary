local NightUI = {}
NightUI.__index = NightUI

function NightUI:Window(opts)
    opts = opts or {}
    local TITLE = opts.Title    or "NightUI"
    local SUB   = opts.SubTitle or ""
    local KEY   = opts.Key
    local W, H  = opts.Width or 295, opts.Height or 355

    local win  = {}
    local tabs = {}

    -- ── ScreenGui ─────────────────────────────────────────────────────────────
    local sg = N("ScreenGui", {
        Name = "NightUI_"..TITLE, ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100, Parent = CoreG,
    })

    _notifRoot = N("Frame", {
        Size = UDim2.new(0,240,1,0), Position = UDim2.new(1,-248,0,8),
        BackgroundTransparency = 1, ZIndex = 59, Parent = sg,
    })
    N("UIListLayout", {
        Padding = UDim.new(0,4), FillDirection = Enum.FillDirection.Vertical,
        VerticalAlignment = Enum.VerticalAlignment.Top, Parent = _notifRoot,
    })

    -- ── Main window frame ─────────────────────────────────────────────────────
    local frame = N("Frame", {
        Name = "NightUI", Size = UDim2.new(0,W,0,H),
        Position = UDim2.new(0.5,-W/2,0.5,-H/2),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = sg,
    })
    AnimBG(frame, 1)
    -- border overlay
    local bframe = N("Frame", {
        Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 3, Parent = frame,
    })
    Rnd(10, bframe); Stroke(C.Border, 1, bframe)

    -- ── Title bar ─────────────────────────────────────────────────────────────
    local TBH = 34
    local tb = N("Frame", {
        Size = UDim2.new(1,0,0,TBH), BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = 8, Parent = frame,
    })
    -- bottom accent line
    N("Frame", {
        Size = UDim2.new(1,0,0,1), Position = UDim2.new(0,0,1,-1),
        BackgroundColor3 = C.Accent, BackgroundTransparency = 0.6,
        BorderSizePixel = 0, ZIndex = 9, Parent = tb,
    })
    -- dot
    local dot = N("Frame", {
        Size = UDim2.new(0,6,0,6), Position = UDim2.new(0,12,0.5,-3),
        BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 9, Parent = tb,
    }); Rnd(999, dot)
    -- pulse the dot
    task.spawn(function()
        while dot and dot.Parent do
            TW(dot, 0.9, { BackgroundColor3 = C.AccentL }, Enum.EasingStyle.Sine)
            task.wait(0.9)
            TW(dot, 0.9, { BackgroundColor3 = C.Accent }, Enum.EasingStyle.Sine)
            task.wait(0.9)
        end
    end)

    N("TextLabel", {
        Size = UDim2.new(1,-85,1,0), Position = UDim2.new(0,23,0,0),
        BackgroundTransparency = 1,
        Text = TITLE .. (SUB ~= "" and ("  ·  "..SUB) or ""),
        TextColor3 = C.Text, TextSize = 11, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = tb,
    })

    -- ── Window control buttons ─────────────────────────────────────────────────
    local function CtrlBtn(xOff, bg)
        local b = N("TextButton", {
            Size = UDim2.new(0,18,0,18), Position = UDim2.new(1,xOff,0.5,-9),
            BackgroundColor3 = bg, BorderSizePixel = 0, Text = "",
            ZIndex = 10, Parent = tb,
        }); Rnd(4, b)
        return b
    end

    local closeBtn = CtrlBtn(-22, C.ERR)
    local minBtn   = CtrlBtn(-44, C.WARN)

    -- draw × on close
    for _, rot in ipairs({45,-45}) do
        local l = N("Frame", {
            Size = UDim2.new(0,9,0,1.4), AnchorPoint = Vector2.new(0.5,0.5),
            Position = UDim2.new(0.5,0,0.5,0), Rotation = rot,
            BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 11, Parent = closeBtn,
        }); Rnd(1,l)
    end
    -- draw − on min
    N("Frame", {
        Size = UDim2.new(0,9,0,1.4), AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0.5,0,0.5,0),
        BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 11, Parent = minBtn,
    })

    Drag(tb, frame)

    local minimised = false
    closeBtn.MouseButton1Click:Connect(function()
        TW(frame, 0.14, { Size = UDim2.new(0,W,0,0), Position = UDim2.new(0.5,-W/2,0.5,0) })
        task.wait(0.15); sg:Destroy()
    end)
    minBtn.MouseButton1Click:Connect(function()
        minimised = not minimised
        TW(frame, 0.16, { Size = UDim2.new(0,W,0, minimised and TBH or H) }, Enum.EasingStyle.Quad)
    end)
    closeBtn.MouseEnter:Connect(function() TW(closeBtn,0.08,{BackgroundColor3=Color3.fromRGB(255,75,85)}) end)
    closeBtn.MouseLeave:Connect(function() TW(closeBtn,0.08,{BackgroundColor3=C.ERR}) end)
    minBtn.MouseEnter:Connect(function()   TW(minBtn,0.08,{BackgroundColor3=Color3.fromRGB(255,195,50)}) end)
    minBtn.MouseLeave:Connect(function()   TW(minBtn,0.08,{BackgroundColor3=C.WARN}) end)

    -- ── Sidebar (tab icons) ────────────────────────────────────────────────────
    local SW = 64  -- sidebar width
    local sidebar = N("Frame", {
        Size = UDim2.new(0,SW,1,-TBH), Position = UDim2.new(0,0,0,TBH),
        BackgroundColor3 = C.Panel, BackgroundTransparency = 0.3,
        BorderSizePixel = 0, ZIndex = 7, Parent = frame,
    })
    -- right divider
    N("Frame", {
        Size = UDim2.new(0,1,1,0), Position = UDim2.new(1,-1,0,0),
        BackgroundColor3 = C.Border, BorderSizePixel = 0, ZIndex = 8, Parent = sidebar,
    })
    N("UIListLayout", {
        Padding = UDim.new(0,2), FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = sidebar,
    })
    Pad(4,4,6,6, sidebar)

    -- ── Content pane ──────────────────────────────────────────────────────────
    local content = N("Frame", {
        Size = UDim2.new(1,-SW,1,-TBH), Position = UDim2.new(0,SW,0,TBH),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6, Parent = frame,
    })

    -- entrance animation
    local bp = frame.Position
    frame.Position = UDim2.new(bp.X.Scale,bp.X.Offset,bp.Y.Scale+0.05,bp.Y.Offset)
    TW(frame, 0.32, { Position = bp }, Enum.EasingStyle.Back)

    -- ════════════════════════════════════════════════════════════════════════
    --  :Tab(name, icon)
    -- ════════════════════════════════════════════════════════════════════════
    function win:Tab(name, icon)
        local tabObj = {}
        icon = icon or ""

        -- sidebar button
        local btn = N("TextButton", {
            Size = UDim2.new(1,0,0,50), BackgroundColor3 = C.Card2,
            BackgroundTransparency = 1, BorderSizePixel = 0,
            Text = "", ZIndex = 9, Parent = sidebar,
        }); Rnd(6, btn)

        -- active left bar
        local bar = N("Frame", {
            Size = UDim2.new(0,3,0,24), AnchorPoint = Vector2.new(0,0.5),
            Position = UDim2.new(0,-3,0.5,0), BackgroundColor3 = C.Accent,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10, Parent = btn,
        }); Rnd(2, bar)

        if icon ~= "" then
            N("TextLabel", {
                Size = UDim2.new(1,0,0,22), Position = UDim2.new(0,0,0,4),
                BackgroundTransparency = 1, Text = icon, TextColor3 = C.TextS,
                TextSize = 15, Font = Enum.Font.GothamBold, ZIndex = 10, Parent = btn,
            })
        end
        N("TextLabel", {
            Size = UDim2.new(1,-4,0,13),
            Position = UDim2.new(0,2,0, icon~=""and 26 or 18),
            BackgroundTransparency = 1, Text = name, TextColor3 = C.TextS,
            TextSize = 9, Font = Enum.Font.GothamMedium, TextWrapped = true,
            ZIndex = 10, Parent = btn,
        })

        -- content scroll frame
        local scroll = N("ScrollingFrame", {
            Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
            BorderSizePixel = 0, ScrollBarThickness = 2,
            ScrollBarImageColor3 = C.AccentD,
            CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false, ZIndex = 7, Parent = content,
        })
        N("UIListLayout", {
            Padding = UDim.new(0,5), FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll,
        })
        Pad(7,7,7,7, scroll)

        local function activate()
            for _, t in ipairs(tabs) do
                t._s.Visible = false
                TW(t._b, 0.13, { BackgroundTransparency = 1 })
                TW(t._bar, 0.13, { BackgroundTransparency = 1, Position = UDim2.new(0,-3,0.5,0) })
                for _, c2 in ipairs(t._b:GetChildren()) do
                    if c2:IsA("TextLabel") then TW(c2,0.13,{TextColor3=C.TextS}) end
                end
            end
            scroll.Visible = true
            TW(btn, 0.13, { BackgroundTransparency = 0.55 })
            TW(bar, 0.13, { BackgroundTransparency = 0, Position = UDim2.new(0,0,0.5,0) })
            for _, c2 in ipairs(btn:GetChildren()) do
                if c2:IsA("TextLabel") then TW(c2,0.13,{TextColor3=C.Text}) end
            end
        end

        btn.MouseButton1Click:Connect(activate)
        tabObj._b = btn; tabObj._s = scroll; tabObj._bar = bar
        table.insert(tabs, tabObj)
        if #tabs == 1 then activate() end

        -- ── Element card ──────────────────────────────────────────────────────
        local function Card(h)
            local c = N("Frame", {
                Size = UDim2.new(1,0,0,h), BackgroundColor3 = C.Card,
                BorderSizePixel = 0, ZIndex = 8, Parent = scroll,
            }); Rnd(6,c); return c
        end

        -- ── Button ────────────────────────────────────────────────────────────
        function tabObj:Button(o)
            o = o or {}
            local c = Card(32)
            N("TextLabel", {
                Size = UDim2.new(1,-28,1,0), Position = UDim2.new(0,11,0,0),
                BackgroundTransparency = 1, Text = o.Name or "Button",
                TextColor3 = C.Text, TextSize = 11, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = c,
            })
            N("TextLabel", {
                Size = UDim2.new(0,14,1,0), Position = UDim2.new(1,-16,0,0),
                BackgroundTransparency = 1, Text = "›", TextColor3 = C.AccentL,
                TextSize = 14, Font = Enum.Font.GothamBold, ZIndex = 9, Parent = c,
            })
            local hit = N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=10,Parent=c})
            hit.MouseButton1Click:Connect(function()
                TW(c,0.07,{BackgroundColor3=C.AccentD})
                task.wait(0.07); TW(c,0.13,{BackgroundColor3=C.Card})
                if o.Callback then o.Callback() end
            end)
            hit.MouseEnter:Connect(function() TW(c,0.1,{BackgroundColor3=C.Card2}) end)
            hit.MouseLeave:Connect(function() TW(c,0.1,{BackgroundColor3=C.Card}) end)
            return tabObj
        end

        -- ── Toggle ────────────────────────────────────────────────────────────
        function tabObj:Toggle(o)
            o = o or {}
            local state = o.Default or false
            local c = Card(32)
            N("TextLabel", {
                Size = UDim2.new(1,-54,1,0), Position = UDim2.new(0,11,0,0),
                BackgroundTransparency = 1, Text = o.Name or "Toggle",
                TextColor3 = C.Text, TextSize = 11, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = c,
            })
            local track = N("Frame", {
                Size = UDim2.new(0,34,0,18), Position = UDim2.new(1,-42,0.5,-9),
                BackgroundColor3 = C.TOff, BorderSizePixel = 0, ZIndex = 9, Parent = c,
            }); Rnd(999, track)
            local knob = N("Frame", {
                Size = UDim2.new(0,12,0,12), Position = UDim2.new(0,3,0.5,-6),
                BackgroundColor3 = Color3.fromRGB(190,190,210), BorderSizePixel = 0, ZIndex = 10, Parent = track,
            }); Rnd(999, knob)

            local function refresh(anim)
                local fn = anim and TW or function(ob,_,pr) for k,v in pairs(pr) do pcall(function() ob[k]=v end) end end
                fn(track, 0.15, { BackgroundColor3 = state and C.TOn or C.TOff })
                fn(knob,  0.15, { Position = state and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6) })
            end
            refresh(false)

            local hit = N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=11,Parent=c})
            hit.MouseButton1Click:Connect(function()
                state = not state; refresh(true)
                if o.Callback then o.Callback(state) end
            end)
            local api = {}
            function api:Set(v) state=v; refresh(true); if o.Callback then o.Callback(state) end end
            function api:Get() return state end
            function api:Toggle() state=not state; refresh(true); if o.Callback then o.Callback(state) end end
            return api
        end

        -- ── Slider ────────────────────────────────────────────────────────────
        function tabObj:Slider(o)
            o = o or {}
            local mn, mx = o.Min or 0, o.Max or 100
            local step   = o.Step or 1
            local val    = math.clamp(o.Default or mn, mn, mx)
            local c      = Card(46)

            local row = N("Frame",{Size=UDim2.new(1,-22,0,18),Position=UDim2.new(0,11,0,5),BackgroundTransparency=1,ZIndex=9,Parent=c})
            N("TextLabel",{Size=UDim2.new(1,-36,1,0),BackgroundTransparency=1,Text=o.Name or"Slider",
                           TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamMedium,
                           TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=row})
            local vLbl=N("TextLabel",{Size=UDim2.new(0,34,1,0),Position=UDim2.new(1,-34,0,0),
                                       BackgroundTransparency=1,Text=tostring(val),TextColor3=C.AccentL,
                                       TextSize=10,Font=Enum.Font.GothamBold,
                                       TextXAlignment=Enum.TextXAlignment.Right,ZIndex=9,Parent=row})

            local trk=N("Frame",{Size=UDim2.new(1,-22,0,5),Position=UDim2.new(0,11,1,-10),
                                  BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=9,Parent=c})
            Rnd(999,trk)
            local fill=N("Frame",{Size=UDim2.new((val-mn)/(mx-mn),0,1,0),BackgroundColor3=C.Accent,
                                   BorderSizePixel=0,ZIndex=10,Parent=trk}); Rnd(999,fill)
            local thumb=N("Frame",{Size=UDim2.new(0,11,0,11),AnchorPoint=Vector2.new(0.5,0.5),
                                    Position=UDim2.new((val-mn)/(mx-mn),0,0.5,0),
                                    BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=11,Parent=trk})
            Rnd(999,thumb)

            local function setV(x)
                local rel = math.clamp((x - trk.AbsolutePosition.X)/trk.AbsoluteSize.X, 0, 1)
                val = math.clamp(math.round((mn+(mx-mn)*rel)/step)*step, mn, mx)
                local pct = (val-mn)/(mx-mn)
                fill.Size = UDim2.new(pct,0,1,0); thumb.Position = UDim2.new(pct,0,0.5,0)
                vLbl.Text = tostring(val)
                if o.Callback then o.Callback(val) end
            end

            local sliding = false
            trk.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                    sliding=true; setV(i.Position.X) end end)
            UIS.InputChanged:Connect(function(i)
                if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                    setV(i.Position.X) end end)
            UIS.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                    sliding=false end end)

            local api = {}
            function api:Set(v)
                val = math.clamp(v,mn,mx); local pct=(val-mn)/(mx-mn)
                fill.Size=UDim2.new(pct,0,1,0); thumb.Position=UDim2.new(pct,0,0.5,0); vLbl.Text=tostring(val)
            end
            function api:Get() return val end
            return api
        end

        -- ── Dropdown ──────────────────────────────────────────────────────────
        function tabObj:Dropdown(o)
            o = o or {}
            local items = o.Items or {}
            local sel   = o.Default or items[1] or "Select"
            local open  = false
            local c     = Card(32)

            N("TextLabel",{Size=UDim2.new(0.5,0,1,0),Position=UDim2.new(0,11,0,0),BackgroundTransparency=1,
                           Text=o.Name or"Dropdown",TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamMedium,
                           TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=c})
            local box=N("Frame",{Size=UDim2.new(0,96,0,22),Position=UDim2.new(1,-104,0.5,-11),
                                  BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=9,Parent=c})
            Rnd(5,box)
            local sLbl=N("TextLabel",{Size=UDim2.new(1,-20,1,0),Position=UDim2.new(0,7,0,0),BackgroundTransparency=1,
                                       Text=sel,TextColor3=C.Text,TextSize=10,Font=Enum.Font.Gotham,
                                       TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,Parent=box})
            local arr=N("TextLabel",{Size=UDim2.new(0,14,1,0),Position=UDim2.new(1,-15,0,0),BackgroundTransparency=1,
                                      Text="▾",TextColor3=C.TextS,TextSize=10,Font=Enum.Font.GothamBold,ZIndex=10,Parent=box})
            local list=N("Frame",{Size=UDim2.new(0,96,0,0),Position=UDim2.new(1,-104,1,3),
                                   BackgroundColor3=C.Card2,BorderSizePixel=0,ClipsDescendants=true,
                                   Visible=false,ZIndex=20,Parent=c})
            Rnd(5,list); Stroke(C.Border,1,list)
            N("UIListLayout",{Padding=UDim.new(0,1),Parent=list}); Pad(3,3,3,3,list)

            for _,item in ipairs(items) do
                local ib=N("TextButton",{Size=UDim2.new(1,0,0,22),BackgroundColor3=C.Card,BackgroundTransparency=0.4,
                                          BorderSizePixel=0,Text=item,TextColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                                          ZIndex=21,Parent=list}); Rnd(3,ib)
                ib.MouseButton1Click:Connect(function()
                    sel=item; sLbl.Text=item; open=false
                    TW(list,0.13,{Size=UDim2.new(0,96,0,0)}); TW(arr,0.13,{Rotation=0})
                    task.wait(0.14); list.Visible=false
                    if o.Callback then o.Callback(sel) end
                end)
                ib.MouseEnter:Connect(function() TW(ib,0.07,{TextColor3=C.Text}) end)
                ib.MouseLeave:Connect(function() TW(ib,0.07,{TextColor3=C.TextS}) end)
            end

            local hit=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=11,Parent=c})
            hit.MouseButton1Click:Connect(function()
                open=not open; list.Visible=true
                TW(list,0.15,{Size=UDim2.new(0,96,0,open and(#items*23+6)or 0)})
                TW(arr,0.15,{Rotation=open and 180 or 0})
                if not open then task.wait(0.16); list.Visible=false end
            end)
            local api={}; function api:Set(v) sel=v; sLbl.Text=v end; function api:Get() return sel end
            return api
        end

        -- ── TextBox ───────────────────────────────────────────────────────────
        function tabObj:TextBox(o)
            o = o or {}
            local c = Card(44)
            N("TextLabel",{Size=UDim2.new(1,-22,0,16),Position=UDim2.new(0,11,0,4),BackgroundTransparency=1,
                           Text=o.Name or"Input",TextColor3=C.TextS,TextSize=9,Font=Enum.Font.Gotham,
                           TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=c})
            local box=N("TextBox",{Size=UDim2.new(1,-22,0,19),Position=UDim2.new(0,11,1,-23),
                                    BackgroundColor3=C.Card2,BorderSizePixel=0,Text=o.Default or"",
                                    PlaceholderText=o.Placeholder or"Type…",TextColor3=C.Text,
                                    PlaceholderColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                                    ClearTextOnFocus=false,ZIndex=9,Parent=c})
            Rnd(4,box); Pad(7,0,0,0,box)
            box.Focused:Connect(function() Stroke(C.Accent,1,box) end)
            box.FocusLost:Connect(function(enter)
                for _,s in ipairs(box:GetChildren()) do if s:IsA("UIStroke") then s:Destroy() end end
                if enter and o.Callback then o.Callback(box.Text) end
            end)
            local api={}; function api:Get() return box.Text end; function api:Set(v) box.Text=v end
            return api
        end

        -- ── Label ─────────────────────────────────────────────────────────────
        function tabObj:Label(text)
            local l = N("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=text or"",
                                      TextColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                                      TextXAlignment=Enum.TextXAlignment.Left,ZIndex=8,Parent=scroll})
            Pad(4,0,0,0,l)
            local api={}; function api:Set(t) l.Text=t end; function api:Get() return l.Text end
            return api
        end

        -- ── Separator ─────────────────────────────────────────────────────────
        function tabObj:Separator(lbl)
            local g=N("Frame",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1,ZIndex=8,Parent=scroll})
            N("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0.5,0),
                       BackgroundColor3=C.Border,BorderSizePixel=0,ZIndex=8,Parent=g})
            if lbl and lbl ~= "" then
                local lf=N("Frame",{Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,
                                     AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,0),
                                     BackgroundColor3=C.BG,BorderSizePixel=0,ZIndex=9,Parent=g})
                Pad(5,5,0,0,lf)
                N("TextLabel",{Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,
                               BackgroundTransparency=1,Text=lbl,TextColor3=C.TextS,
                               TextSize=9,Font=Enum.Font.GothamMedium,ZIndex=9,Parent=lf})
            end
        end

        -- ── Keybind ───────────────────────────────────────────────────────────
        function tabObj:Keybind(o)
            o = o or {}
            local bound, waiting = o.Default, false
            local c = Card(32)
            N("TextLabel",{Size=UDim2.new(0.55,0,1,0),Position=UDim2.new(0,11,0,0),BackgroundTransparency=1,
                           Text=o.Name or"Keybind",TextColor3=C.Text,TextSize=11,Font=Enum.Font.GothamMedium,
                           TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9,Parent=c})
            local kf=N("Frame",{Size=UDim2.new(0,60,0,20),Position=UDim2.new(1,-68,0.5,-10),
                                 BackgroundColor3=C.Card2,BorderSizePixel=0,ZIndex=9,Parent=c}); Rnd(4,kf)
            local kl=N("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
                                     Text=bound and tostring(bound):gsub("Enum.KeyCode.","") or"None",
                                     TextColor3=C.AccentL,TextSize=9,Font=Enum.Font.GothamBold,ZIndex=10,Parent=kf})
            local hit=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=11,Parent=c})
            hit.MouseButton1Click:Connect(function()
                waiting=true; kl.Text="…"; TW(kf,0.1,{BackgroundColor3=C.AccentD})
            end)
            UIS.InputBegan:Connect(function(i)
                if not waiting then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    waiting=false; bound=i.KeyCode
                    kl.Text=tostring(i.KeyCode):gsub("Enum.KeyCode.","")
                    TW(kf,0.1,{BackgroundColor3=C.Card2})
                    if o.Callback then o.Callback(bound) end
                end
            end)
            local api={}
            function api:Get() return bound end
            function api:Set(kc) bound=kc; kl.Text=tostring(kc):gsub("Enum.KeyCode.","") end
            return api
        end

        return tabObj
    end -- :Tab()

    function win:Notify(o) Notif(o) end
    function win:Destroy() sg:Destroy() end

    -- ════════════════════════════════════════════════════════════════════════
    --  KEY GATE  ← overlay on top of already-built window
    --             Window is ALWAYS built first so :Tab() works immediately.
    --             The overlay just blocks until the correct key is entered.
    -- ════════════════════════════════════════════════════════════════════════
    if KEY then
        local keys = type(KEY) == "table" and KEY or { KEY }

        local overlay = N("Frame",{
            Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(0,0,0),
            BackgroundTransparency=0.25, ZIndex=90, Parent=sg,
        })
        AnimBG(overlay, 91)

        local kcard = N("Frame",{
            Size=UDim2.new(0,250,0,165),
            Position=UDim2.new(0.5,-125,0.5,-82),
            BackgroundColor3=C.Panel, BorderSizePixel=0, ZIndex=96, Parent=sg,
        }); Rnd(10,kcard); Stroke(C.Accent,1,kcard)

        -- top strip
        local kstrip=N("Frame",{Size=UDim2.new(1,0,0,3),BackgroundColor3=C.Accent,BorderSizePixel=0,ZIndex=97,Parent=kcard})
        Rnd(10,kstrip)

        N("TextLabel",{Size=UDim2.new(1,0,0,34),Position=UDim2.new(0,0,0,8),BackgroundTransparency=1,
                       Text="🔑  Authentication",TextColor3=C.Text,TextSize=13,Font=Enum.Font.GothamBold,
                       ZIndex=97,Parent=kcard})
        N("TextLabel",{Size=UDim2.new(1,-24,0,14),Position=UDim2.new(0,12,0,38),BackgroundTransparency=1,
                       Text="Enter your key to continue",TextColor3=C.TextS,TextSize=10,Font=Enum.Font.Gotham,
                       TextXAlignment=Enum.TextXAlignment.Left,ZIndex=97,Parent=kcard})

        local kinput=N("TextBox",{Size=UDim2.new(1,-24,0,30),Position=UDim2.new(0,12,0,58),
                                   BackgroundColor3=C.Card2,BorderSizePixel=0,Text="",
                                   PlaceholderText="paste key here…",TextColor3=C.Text,PlaceholderColor3=C.TextS,
                                   TextSize=11,Font=Enum.Font.GothamMedium,ClearTextOnFocus=false,
                                   ZIndex=98,Parent=kcard})
        Rnd(6,kinput); Pad(10,0,0,0,kinput); Stroke(C.Border,1,kinput)

        local ubtn=N("TextButton",{Size=UDim2.new(1,-24,0,28),Position=UDim2.new(0,12,0,96),
                                    BackgroundColor3=C.Accent,BorderSizePixel=0,Text="Unlock",
                                    TextColor3=Color3.new(1,1,1),TextSize=11,Font=Enum.Font.GothamBold,
                                    ZIndex=98,Parent=kcard}); Rnd(6,ubtn)

        local eLbl=N("TextLabel",{Size=UDim2.new(1,-24,0,13),Position=UDim2.new(0,12,0,130),
                                   BackgroundTransparency=1,Text="",TextColor3=C.ERR,
                                   TextSize=9,Font=Enum.Font.Gotham,
                                   TextXAlignment=Enum.TextXAlignment.Left,ZIndex=97,Parent=kcard})

        -- entrance
        kcard.Position = UDim2.new(0.5,-125,0.54,-82); kcard.BackgroundTransparency=1
        TW(kcard,0.28,{Position=UDim2.new(0.5,-125,0.5,-82),BackgroundTransparency=0},Enum.EasingStyle.Back)

        local function shake()
            for _,dx in ipairs({-6,6,-4,4,-2,2,0}) do
                TW(kcard,0.04,{Position=UDim2.new(0.5,-125+dx,0.5,-82)}); task.wait(0.04)
            end
        end

        local function check()
            local v = kinput.Text:gsub("%s","")
            for _, k in ipairs(keys) do
                if v == k then
                    TW(ubtn,0.15,{BackgroundColor3=C.OK}); task.wait(0.28)
                    TW(overlay,0.2,{BackgroundTransparency=1}); TW(kcard,0.2,{BackgroundTransparency=1})
                    task.wait(0.22); overlay:Destroy(); kcard:Destroy()
                    return
                end
            end
            eLbl.Text = "✕  Wrong key, try again"
            TW(ubtn,0.07,{BackgroundColor3=C.ERR}); task.wait(0.08)
            TW(ubtn,0.13,{BackgroundColor3=C.Accent})
            shake(); task.delay(2.5,function() eLbl.Text="" end)
        end

        ubtn.MouseButton1Click:Connect(check)
        kinput.FocusLost:Connect(function(enter) if enter then check() end end)
        ubtn.MouseEnter:Connect(function() TW(ubtn,0.08,{BackgroundColor3=C.AccentL}) end)
        ubtn.MouseLeave:Connect(function() TW(ubtn,0.08,{BackgroundColor3=C.Accent}) end)
    end

    return win
end

