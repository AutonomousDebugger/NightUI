--[[
  NightUI v2.1  —  Bug fixes
  · Key gate no longer leaves window empty after unlock
  · Sidebar tabs now look and feel like actual tabs
  · Minor polish

  LOAD:
    local UI = loadstring(game:HttpGet("RAW_URL"))()

  USAGE:
    local win = UI:Window({ Title="Hub", Key="abc123" })
    local tab = win:Tab("Main", "⚔️")
    tab:Button({ Name="Fly",    Callback=function() end })
    tab:Toggle({ Name="Noclip", Default=false, Callback=function(v) end })
    tab:Slider({ Name="Speed",  Min=0, Max=100, Default=16, Callback=function(v) end })
    tab:Dropdown({ Name="Mode", Items={"A","B","C"}, Callback=function(v) end })
    tab:TextBox({ Name="Name",  Placeholder="type…", Callback=function(v) end })
    tab:Keybind({ Name="Toggle",Callback=function(k) end })
    tab:Label("info text")
    tab:Separator("section")
    win:Notify({ Title="Hi", Message="works!", Type="success" })
]]

local UIS    = game:GetService("UserInputService")
local TweenS = game:GetService("TweenService")
local CoreG  = game:GetService("CoreGui")

