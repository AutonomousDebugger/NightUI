--  ANIMATED BACKGROUND  (floating orbs + scanlines)
-- ══════════════════════════════════════════════════════════
local function BuildAnimBG(parent)
    local bg = New("Frame", {
        Size              = UDim2.new(1,0,1,0),
        BackgroundColor3  = T.BG,
        BorderSizePixel   = 0,
        ZIndex            = 1,
        Parent            = parent,
        ClipsDescendants  = true,
    })

    -- Scanline texture illusion via thin repeating frames
    local scanHolder = New("Frame", {
        Size             = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        ZIndex           = 2,
        Parent           = bg,
        ClipsDescendants = true,
    })
    for i = 0, 30 do
        New("Frame", {
            Size             = UDim2.new(1,0,0,1),
            Position         = UDim2.new(0,0,0, i*14),
            BackgroundColor3 = Color3.fromRGB(255,255,255),
            BackgroundTransparency = 0.97,
            BorderSizePixel  = 0,
            ZIndex           = 2,
            Parent           = scanHolder,
        })
    end

    -- Glowing orbs
    local orbColors = {
        Color3.fromRGB(80, 30, 200),
        Color3.fromRGB(40, 10, 120),
        Color3.fromRGB(100, 20, 180),
        Color3.fromRGB(20, 10,  90),
    }
    for i, col in ipairs(orbColors) do
        local orb = New("Frame", {
            Size                   = UDim2.new(0,160,0,160),
            Position               = UDim2.new(math.random()*0.8, 0, math.random()*0.8, 0),
            BackgroundColor3       = col,
            BackgroundTransparency = 0.78,
            BorderSizePixel        = 0,
            ZIndex                 = 2,
            Parent                 = bg,
        })
        Corner(999, orb)

        -- Float animation
        local function drift()
            while orb and orb.Parent do
                local tx = math.random(0,80)/100
                local ty = math.random(0,80)/100
                local dur = math.random(4,9)
                Tween(orb, dur, {
                    Position = UDim2.new(tx,0,ty,0),
                    BackgroundTransparency = 0.72 + math.random()*0.1,
                }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                task.wait(dur)
            end
        end
        task.delay(i * 0.4, drift)
    end

    -- Top edge accent glow bar
    New("Frame", {
        Size             = UDim2.new(1,0,0,2),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 0.4,
        BorderSizePixel  = 0,
        ZIndex           = 10,
        Parent           = parent,
    })

    return bg
end

