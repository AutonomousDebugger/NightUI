  USAGE:
    local win = UI:Window({ Title="Hub", Key="abc123" })
    local tab = win:Tab("Main","⚔️")
    tab:Button({ Name="Click Me",  Callback=function() end })
    tab:Toggle({ Name="Fly",       Default=false, Callback=function(v) end })
    tab:Slider({ Name="Speed",     Min=0, Max=100, Default=16, Callback=function(v) end })
    tab:Dropdown({ Name="Team",    Items={"Red","Blue"}, Callback=function(v) end })
