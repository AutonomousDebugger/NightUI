function NightUI:SetKeys(keys)
	if typeof(keys) == "string" then
		self.Config.Key = keys
		self.Config.Keys = { keys }
	elseif typeof(keys) == "table" then
		self.Config.Keys = keys
		self.Config.Key = keys[1]
	end

	return self
end

function NightUI:SetKeySystem(enabled)
	self.Config.KeySystem = enabled and true or false
	return self
end

function NightUI:SetConfig(config)
	config = config or {}

	if config.KeySystem ~= nil then
		self.Config.KeySystem = config.KeySystem and true or false
	end

	if config.Key ~= nil then
		self.Config.Key = config.Key
		self.Config.Keys = { config.Key }
	end

	if config.Keys ~= nil then
		self.Config.Keys = config.Keys
		self.Config.Key = config.Keys[1]
	end

	if config.Name ~= nil then
		self.Config.Name = config.Name
	end

	return self
end

