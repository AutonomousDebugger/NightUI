                    Size             = UDim2.new(0,6,0,6),
                    Position         = UDim2.new(0,0,0,-3),
                    BackgroundColor3 = T.Accent,
                    BackgroundTransparency = 1,
                    BorderSizePixel  = 0,
                    ZIndex           = 8,
                    Parent           = c,
                })
                Corner(999, indicator)

                local function refresh(animate)
                    local fn = animate and Tween or function(o,_,p) for k,v in pairs(p) do o[k]=v end end
                    if state then
                        fn(track, 0.18, { BackgroundColor3 = T.ToggleOn })
                        fn(knob,  0.18, { Position = UDim2.new(1,-19,0.5,-8) })
                        fn(indicator, 0.18, { BackgroundTransparency = 0.4 })
                    else
                        fn(track, 0.18, { BackgroundColor3 = T.ToggleOff })
                        fn(knob,  0.18, { Position = UDim2.new(0,3,0.5,-8) })
                        fn(indicator, 0.18, { BackgroundTransparency = 1 })
                    end
                end
                refresh(false)

                local function toggle()
                    state = not state
                    refresh(true)
                    if o.Callback then o.Callback(state) end
                end

                c.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                    or inp.UserInputType == Enum.UserInputType.Touch then
                        toggle()
                    end
                end)

                local api = {}
                function api:Set(v)   state = v refresh(true) if o.Callback then o.Callback(state) end end
                function api:Get()    return state end
                function api:Toggle() toggle() end
                return api
            end

            -- ── SLIDER ─────────────────────────────────────
            function tabObj:Slider(o)
                o = o or {}
                local min  = o.Min     or 0
                local max  = o.Max     or 100
                local val  = math.clamp(o.Default or min, min, max)
                local step = o.Step    or 1
                local c    = Card(54)

                local topRow = New("Frame", {
                    Size             = UDim2.new(1,-24,0,24),
                    Position         = UDim2.new(0,12,0,6),
                    BackgroundTransparency = 1,
                    ZIndex           = 9,
                    Parent           = c,
