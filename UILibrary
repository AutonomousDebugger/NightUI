        -- Demo / README window
        local w = NightUI:Window({
            Title    = "NightUI",
            SubTitle = "v1.0",
        })
        local t = w:Tab("Info", "📋")
        t:Label("Welcome to NightUI!")
        t:Label("Assign a Key= to lock it behind auth.")
        t:Separator("Quick Demo")
        local tog = t:Toggle({ Name = "Demo Toggle", Default = true, Callback = function(v)
            w:Notify({ Title="Toggle", Message="Value: "..tostring(v), Type="info" })
        end })
        t:Slider({ Name = "Demo Slider", Min=0, Max=100, Default=50 })
        t:Button({ Name = "Send Notification", Callback = function()
            w:Notify({ Title="NightUI", Message="Button clicked!", Type="success", Duration=2.5 })
        end })

        local t2 = w:Tab("API", "⚙️")
        t2:Label(":Window( Title, SubTitle, Key )")
        t2:Label(":Tab( name, icon )")
        t2:Separator("Elements")
        t2:Label(":Button  :Toggle  :Slider")
        t2:Label(":Dropdown  :TextBox  :Label")
        t2:Label(":Keybind  :ColorPicker  :Separator")
        t2:Separator()
        t2:Label(":Notify{ Title, Message, Type, Duration }")
    end
end)

-- ══════════════════════════════════════════════════════════
return NightUI
