				Position = UDim2.fromOffset(10, 34),
				BackgroundColor3 = Color3.fromRGB(35, 35, 45),
				Text = "",
				AutoButtonColor = false,
				ZIndex = 24,
				Parent = holder
			}, {
				corner(99)
